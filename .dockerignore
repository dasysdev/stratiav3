# Build context: only what the Dockerfile copies (workspace manifests, code, entrypoint).
# Data (var/), secrets (.env), docs and the rest of the project stay out.
*
!pyproject.toml
!uv.lock
!env/docker/
!capture/pyproject.toml
!capture/src/
!demand-engine/pyproject.toml
!demand-engine/src/
!info-audit/pyproject.toml
!info-audit/src/
!info-audit/schemas/
!references/pyproject.toml
!references/src/
!web-audit/pyproject.toml
!web-audit/src/
**/.env
**/__pycache__
**/.pytest_cache
