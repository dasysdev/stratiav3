  "candidates": [
    {
      "question": "¿Tiene la oferta condiciones para los socios de un programa de fidelización (precio de socio, puntos que se obtienen con la compra) y cuáles?",
      "entity": "oferta",
      "block": "gen",
      "status": "propuesto",
      "sources": [
        "google-search-merchant-listing:UnitPriceSpecification.membershipPointsEarned@2026-10-27",
        "google-search-organization:Organization.hasMemberProgram@2026-10-27"
      ],
      "rationale": "Ninguna cuestión de la capa general pregunta por un programa de fidelización; gen/16 pregunta por promociones vigentes, y el precio de socio y los puntos son condiciones de pertenencia, no promociones."
    },
    {
      "question": "¿Desde qué país o lugar se envía el pedido?",
      "entity": "entrega",
      "block": "gen",
      "status": "propuesto",
      "sources": [
        "google-search-shipping-policy:ShippingConditions.shippingOrigin@2026-10-27"
      ],
      "rationale": "El origen del envío no lo pregunta ninguna cuestión de la entrega (coste, plazo, modalidades); puede cambiar el plazo y, fuera de la UE, los costes de importación."
    },
