{
  "note": "Rasgo principal de un requisito: qué resuelve la cuestión (D-045). Lista cerrada. 'sources' asocia cada fuente (atributo de Shopify, propiedad o valor de Amazon) a su rasgo; lo genera 'bin/train index' a partir del catálogo y se reutiliza en todas las categorías.",
  "vocabulary": {
    "identidad": {
      "label": "identidad",
      "definition": "Qué tipo, subtipo o forma de producto es (tipo de bota, tipo de pienso, forma del cojín, tipo de sofá)."
    },
    "contenido": {
      "label": "contenido",
      "definition": "Qué piezas, unidades o accesorios incluye la oferta (cuántas fundas, si incluye colchón, si incluye premios)."
    },
    "medida-que-fija": {
      "label": "medida que fija lo vendido",
      "definition": "Medida, talla o cantidad neta que identifica la variante que se vende: talla de calzado, medida de cama, colchón o almohada, medidas de la toalla, peso neto del envase (D-043, criterio 1)."
    },
    "medida": {
      "label": "medida descriptiva",
      "definition": "Dimensiones o talla que describen el producto sin fijar qué variante se vende (medidas de un sofá, de un cojín, de la cama abierta). El peso, el grosor y el gramaje son magnitud física (D-051)."
    },
    "magnitud": {
      "label": "magnitud física",
      "definition": "Peso, grosor o gramaje del producto o de su tejido (D-051). Sin regla fija: su importancia la decide el árbol por clase."
    },
    "material": {
      "label": "material",
      "definition": "Materiales, composición en fibras, tejido, relleno, ingredientes o componentes analíticos, incluido el material reciclado."
    },
    "construccion": {
      "label": "construcción",
      "definition": "Cómo está hecho: estructura, confección, acabado del tejido, cierre, mecanismo, suela, costuras, tipo de tejido por su fabricación (punto, tejido plano)."
    },
    "prestacion": {
      "label": "prestación",
      "definition": "Rendimiento o propiedad funcional que ofrece: abrigo, absorción, firmeza, impermeabilidad, transpirabilidad, resistencia, durabilidad, antiácaros, antideslizante."
    },
    "uso": {
      "label": "uso y compatibilidad",
      "definition": "Para qué, para quién, dónde y con qué se usa: destinatario (edad, sexo, tamaño o raza del animal), entorno, temporada, ocasión, ajuste al cuerpo, compatibilidad con otros productos, forma de uso o de preparación."
    },
    "seguridad": {
      "label": "seguridad",
      "definition": "Advertencias, riesgos, edad mínima, cumplimiento de normas de seguridad."
    },
    "cuidado": {
      "label": "cuidado",
      "definition": "Lavado, limpieza, secado, planchado, mantenimiento, conservación y almacenamiento."
    },
    "estetica": {
      "label": "estética",
      "definition": "Color, estampado, patrón, estilo decorativo, diseño y acabado visual."
    },
    "certificacion-origen": {
      "label": "certificación u origen",
      "definition": "Certificaciones y sellos que no son de seguridad, país o lugar de fabricación, sostenibilidad declarada."
    }
  },
